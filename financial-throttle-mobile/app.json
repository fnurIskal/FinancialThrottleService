{
  "expo": {
    "name": "financial-throttle-mobile",
    "slug": "financial-throttle-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/AppIcon.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.example.financialthrottlemobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/AppIcon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/FavIcon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#DC2626"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/AppIcon.png",
          "resizeMode": "contain",
          "backgroundColor": "#477DD7"
        }
      ]
    ]
  }
}