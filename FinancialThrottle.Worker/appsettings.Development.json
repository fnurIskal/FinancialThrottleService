        "WorkerIntervalSeconds": 30,
        "UseDummyData": false
    },
    "DatabaseNames": {
        "Management": "RAS_STAJ",
        "Reference": "RAS_STAJ",
        "Heartbeat": "RAS_STAJ",
        "Turkey": "RAS_STAJ107",
        "MsSource": "RAS_STAJ32501"
    },
    "SecurityPriorityApi": {
        "BaseUrl": "http://localhost:11080/",
        "TimeoutSeconds": 10
    },
    "FinancialTransactionApi": {
        "BaseUrl": "https://api.example.com/service-financialtransactionhub-test/",
        "TimeoutSeconds": 120
    },
    "Logging": {
        "LogLevel": {
